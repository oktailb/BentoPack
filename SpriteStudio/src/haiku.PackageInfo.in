name                  @PROJECT_NAME@
version               @PROJECT_VERSION@-1
architecture          x86_64
summary               "Animated Sprite Management and Assembly Tool"
description           "Sprite Studio is a work-in-progress (WIP) development tool designed to help game creators and pixel artists efficiently manage, slice, and arrange animation sequences from various source materials (GIFs, consolidated image files, or individual frames)."
packager              "LECOQ Vincent <vincent.lecoq@gmail.com>"
vendor                "Oktailb"

licenses {
    "Apache License Version 2.0"
}

copyrights {
    "Copyright (C) 2025-2026 by @GIT_LAST_AUTHOR@ <@GIT_LAST_EMAIL@>"
}

provides {
    @PROJECT_NAME@ = @PROJECT_VERSION@-1
    cmd:@PROJECT_NAME@ = @PROJECT_VERSION@-1
}

requires {
    haiku >= r1~beta4
    lib:libQt6Core
    lib:libQt6Gui
    lib:libQt6Widgets
    lib:libQt6Concurrent
    lib:libgit2
}

urls {
        "https://github.com/oktailb/SpriteStudio"
}

global-writable-files {
}
